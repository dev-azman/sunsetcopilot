{
  "name": "Collections Copilot daily lists",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "collections-copilot",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://YOUR-SITE.netlify.app"
        }
      },
      "name": "Copilot webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Copilot secret (header X-Copilot-Secret)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {status:'ok'} }}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        260,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const b=$input.first().json.body||$input.first().json;\nif(!Array.isArray(b.executives)) throw new Error('bad payload');\nreturn b.executives.slice(0,100).map(e=>({json:{executive:String(e.executive||'Unassigned').slice(0,80),\n text:\"Today's top calls for \"+String(e.executive||'Unassigned').slice(0,80)+\":\\n\"+(e.calls||[]).slice(0,10).map((c,i)=>(i+1)+'. '+String(c.customer).slice(0,60)+' | due '+Number(c.due||0).toLocaleString()+' | '+String(c.action).slice(0,70)).join('\\n')}}));"
      },
      "name": "Validate + split by executive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#collections-daily"
        },
        "text": "={{ $json.text }}"
      },
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        520,
        100
      ],
      "credentials": {
        "slackApi": {
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "Copilot webhook": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          },
          {
            "node": "Validate + split by executive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate + split by executive": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}